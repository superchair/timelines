# Copy to .env and fill in. Never commit .env.

# mock  = built-in demo data, no Jira needed
# token = your own Jira API token (local development only; everyone acts as you)
# oauth = Atlassian OAuth 2.0 (3LO); each user signs in and acts as themselves (required in production)
AUTH_MODE=mock

PORT=3001
# Public URL of the app (Vite dev server in development).
APP_BASE_URL=http://localhost:5173
# Long random string, e.g. `openssl rand -hex 32`. Required in production.
SESSION_SECRET=
# Set to true when running behind a load balancer / reverse proxy that terminates TLS.
TRUST_PROXY=false

# --- OAuth 2.0 (3LO) — from developer.atlassian.com/console/myapps ---
ATLASSIAN_CLIENT_ID=
ATLASSIAN_CLIENT_SECRET=
OAUTH_REDIRECT_URI=http://localhost:5173/auth/callback
# Space or comma separated. Must match the scopes added to the app in the developer console.
# Default: read:jira-work write:jira-work read:jira-user offline_access read:board-scope:jira-software read:board-scope.admin:jira-software read:project:jira
OAUTH_SCOPES=

# --- API token mode ---
JIRA_SITE_URL=https://your-site.atlassian.net
JIRA_EMAIL=
# https://id.atlassian.com/manage-profile/security/api-tokens
JIRA_API_TOKEN=

# --- Jira conventions (optional) ---
# JQL clause that selects the top-level items drawn on the timeline.
EPIC_JQL_CLAUSE=issuetype = Epic
# Link types treated as dependencies. The first one is used when creating dependencies.
DEPENDENCY_LINK_TYPES=Blocks
# Field IDs are discovered automatically; set these only to override.
START_DATE_FIELD_ID=
SPRINT_FIELD_ID=
TEAM_FIELD_ID=
MAX_EPICS=500
MAX_CHILDREN=3000
CACHE_TTL_SECONDS=60
